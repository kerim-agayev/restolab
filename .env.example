# =====================================================================
#  .env.example — Senior Engineer Lab (RestoLab)
#  1) Kopyala:  Copy-Item .env.example .env
#  2) .env içini doldur. .env ASLA GitHub'a gitmez (.gitignore'da).
#  3) Her değişkenin nereden alınacağı: docs/TOKENS.md  (hangi gün lazım olduğu yanında)
#  Hepsini birden alma — sadece o günün dersinde lazım olanı.
# =====================================================================

# ---------------------------------------------------------------------
# [GÜN 1] Uygulama & ortam
#  RELEASE_CHANNEL: local | preview | alpha | beta | rc | prod   (Clopos'taki kanallar)
# ---------------------------------------------------------------------
NODE_ENV=development
RELEASE_CHANNEL=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# [GÜN 12] Neon Postgres — CONTROL PLANE DB (Prisma)
#  Kullanıcılar, restoranlar, restoran→DB eşlemesi, release kanalı, feature flag'ler burada.
#  Pooled (host'unda -pooler) -> uygulama;  Direct -> migration
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/control_db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/control_db?sslmode=require

# ---------------------------------------------------------------------
# [GÜN 15] Auth — kendin üretirsin:
#  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------
AUTH_ACCESS_TOKEN_SECRET=change-me
AUTH_REFRESH_TOKEN_SECRET=change-me
AUTH_COOKIE_NAME=restolab_session
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------
# [GÜN 30] Database-per-tenant (order-service, Drizzle)
#  TENANT_ADMIN_DATABASE_URL -> DIRECT (pooler'sız) bağlantı; CREATE DATABASE tenant_<slug> bununla çalışır
#  TENANT_DATABASE_URL_TEMPLATE -> {db} yerine tenant DB adı konur
# ---------------------------------------------------------------------
TENANT_ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/postgres?sslmode=require
TENANT_DATABASE_URL_TEMPLATE=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/{db}?sslmode=require

# [GÜN 23] Servisler arası
INTERNAL_SERVICE_TOKEN=change-me
ORDER_SERVICE_URL=http://localhost:4001
MENU_SERVICE_URL=http://localhost:4002
REALTIME_GATEWAY_URL=ws://localhost:4003
SEARCH_SERVICE_URL=http://localhost:4004

# ---------------------------------------------------------------------
# [GÜN 35] MongoDB Atlas — menu-service (Mongoose)
# ---------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restolab_menu?retryWrites=true&w=majority

# [GÜN 41] Upstash Redis
#  REST -> Vercel/Next.js (HTTP);  REDIS_URL -> NestJS servisleri & worker'lar (TCP)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# [GÜN 44] Resend — e-posta (fiş, Z raporu)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# ---------------------------------------------------------------------
# [GÜN 46] Aiven Kafka (Free)
#  Local docker-compose Kafka'da: KAFKA_BROKERS=localhost:9092, SASL değişkenlerini boş bırak
# ---------------------------------------------------------------------
KAFKA_BROKERS=kafka-xxxx-project.aivencloud.com:12345
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=
KAFKA_CA_CERT_PATH=./certs/kafka-ca.pem
KAFKA_CLIENT_ID=restolab

# [GÜN 55] Stripe (TEST mode — gerçek para yok)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ---------------------------------------------------------------------
# [GÜN 60] Elasticsearch + Kibana — LOCAL Docker (token gerekmez)
# ---------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme-local
KIBANA_URL=http://localhost:5601

# ---------------------------------------------------------------------
# [GÜN 70] Neon API — CI'da her PR için otomatik DB branch'i (opsiyonel, Vercel-Neon entegrasyonu da yapabilir)
# ---------------------------------------------------------------------
NEON_API_KEY=
NEON_PROJECT_ID=

# [GÜN 76] Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# [GÜN 75] Grafana Cloud — OpenTelemetry
OTEL_SERVICE_NAME=web
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64(instanceId:token)

# [GÜN 79] Security lab — SADECE local
LAB_MODE=false

# ---------------------------------------------------------------------
# CI/CD secret'ları BU DOSYAYA DEĞİL -> GitHub repo -> Settings -> Secrets and variables -> Actions
#  VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, RENDER_DEPLOY_HOOK_*, NEON_API_KEY
# ---------------------------------------------------------------------
